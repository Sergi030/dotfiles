profile home_tri {
    output "Lenovo Group Limited T24i-2L VNA73FRH" enable mode 1920x1080@60 position 1920,0 scale 1 transform 180
    output "AOC 27G2G4 0x00017409" enable mode 1920x1080@144 position 1920,1080 scale 1
    output "Lenovo Group Limited T24i-2L VNA73FRP" enable mode 1920x1080@60 position 3840,500 scale 1 transform 270
    output eDP-1 disable

    exec reload-hyprland
}

profile home {
    output "AOC 27G2G4 0x00017409" enable mode 1920x1080@60 position 1920,840 scale 1
    output "Lenovo Group Limited T24i-2L VNA73FRP" enable mode 1920x1080@60 position 3840,0 scale 1 transform 270
    output eDP-1 disable
    exec reload-hyprland
}

profile laptop {
    output eDP-1 enable position 0,720 scale 1.00
    exec hyprctl reload
    exec reload-hyprland
}

profile office {
    output eDP-1 enable mode 1920x1200@60 position 0,1560 scale 1
