profile home {
    output DP-5 enable mode 1920x1080@60 position 1920,840 scale 1
    output DP-8 enable position 3840,0 scale 1 transform 270
    output eDP-1 disable
    exec reload-hyprland home
}

profile home2 {
    output DP-11 enable mode 1920x1080@60 position 1920,840 scale 1
    output DP-7 enable position 3840,0 scale 1 transform 270
    output eDP-1 disable
    exec reload-hyprland home2
}

profile home3 {
    output DP-6 enable mode 1920x1080@60 position 1920,840 scale 1
    output DP-10 enable position 3840,0 scale 1 transform 270
    output eDP-1 disable
    exec reload-hyprland home3
}

profile laptop {
    output eDP-1 enable position 0,720 scale 1.00
    exec hyprctl reload
    exec reload-hyprland laptop
}

profile office {
    output eDP-1 enable mode 1920x1200@60 position 0,1560 scale 1
    output DP-6 enable mode 1920x1080@60 position 1920,1680 scale 1
    output DP-7 enable mode 1920x1080@60 position 3840,840 scale 1 transform 270
    exec reload-hyprland office
}

profile office2 {
    output eDP-1 enable mode 1920x1200@60 position 0,1560 scale 1
    output DP-5 enable mode 1920x1080@60 position 1920,1680 scale 1
    output DP-6 enable mode 1920x1080@60 position 3840,840 scale 1 transform 270
    exec reload-hyprland office2
}

profile office3 {
    output eDP-1 enable mode 1920x1200@60 position 0,1560 scale 1
    output DP-5 enable mode 1920x1080@60 position 1920,1680 scale 1
    output DP-7 enable mode 1920x1080@60 position 3840,840 scale 1 transform 270
    exec reload-hyprland office3
}

profile office5 {
    output eDP-1 enable mode 1920x1200@60 position 0,1560 scale 1
    output HDMI-A-1 enable mode 1920x1080@60 position 1920,1680 scale 1
    exec reload-hyprland office5
}
