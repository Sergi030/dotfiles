[Unit]
Description=Cliphist text clipboard watcher
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# Skip cleanly (not "failed") on machines without cliphist installed.
ConditionFileIsExecutable=|/usr/bin/cliphist
ConditionFileIsExecutable=|/usr/local/bin/cliphist
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/env wl-paste --type text --watch cliphist store
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
