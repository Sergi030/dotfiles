#!/bin/bash

profile="$(kanshictl status | awk '{print $3}')"
principal="eDP-1"
secondary=""
tertiary=""

get_monitor_name_by_desc() {
    local wanted_desc="$1"
    hyprctl monitors all | awk -v desc="$wanted_desc" '
        /^Monitor / {
            mon=$2
            sub(/\(.*/, "", mon)
            current=mon
        }
        /^[[:space:]]*description: / {
            line=$0
            sub(/^[[:space:]]*description: /, "", line)
            if (line == desc) {
                print current
                exit
            }
        }
    '
}


case "$profile" in
    home)
        principal="AOC 27G2G4 0x00017409"
        secondary="Dell Inc. DELL P2417H 5N99G7CQ1D9B"
        ;;
esac

principal="$(get_monitor_name_by_desc "$principal")"
secondary="$(get_monitor_name_by_desc "$secondary")"
echo "principal=$principal"
echo "secondary=$secondary"

workspaces_file="$HOME/.config/hypr/workspaces.conf"

{
  echo "# Generated automatically for profile '$profile' on $(date '+%Y-%m-%d %H:%M:%S')"
  echo

  #
  # Workspaces 1–10 → principal monitor
  #
  echo "workspace=1,monitor:$principal,default:true"
  for i in {2..10}; do
    echo "workspace=$i,monitor:$principal"
  done

  #
  # Workspaces 11–19 → secondary monitor (only if present)
  #
  if [ -n "$secondary" ]; then
    echo "workspace=11,monitor:$secondary,default:true"
    for i in {12..19}; do
      echo "workspace=$i,monitor:$secondary"
    done
  fi

  #
  # Workspace 20 → tertiary monitor, if it exists;
  # otherwise → secondary monitor
  #
  if [ -n "$tertiary" ]; then
    echo "workspace=20,monitor:$tertiary"
  fi

} > "$workspaces_file"

# small delay
sleep 0.2

# 1–10 → principal
for i in {1..10}; do
    hyprctl dispatch moveworkspacetomonitor "$i" "$principal" >/dev/null 2>&1
done

# 11–19 → secondary
if [ -n "$secondary" ]; then
    for i in {11..19}; do
        hyprctl dispatch moveworkspacetomonitor "$i" "$secondary" >/dev/null 2>&1
    done
fi

# 20 → tertiary > secondary > principal
if [ -n "$tertiary" ]; then
    hyprctl dispatch moveworkspacetomonitor 20 "$tertiary" >/dev/null 2>&1
elif [ -n "$secondary" ]; then
    hyprctl dispatch moveworkspacetomonitor 20 "$secondary" >/dev/null 2>&1
else
    hyprctl dispatch moveworkspacetomonitor 20 "$principal" >/dev/null 2>&1
fi



# ensure awww daemon is running
if ! pgrep -x awww-daemon >/dev/null 2>&1; then
    awww-daemon &disown
    sleep 0.5
fi

# set wallpaper to all screens
awww img ~/.config/hypr/background.png

sleep 1

if ! pgrep -x waybar >/dev/null; then
    waybar & disown
fi

# ensure wl-clip-persist is running
if ! pgrep -x wl-clip-persist >/dev/null 2>&1; then
    wl-clip-persist --clipboard regular &disown
fi

# ensure polkit agent is running
systemctl --user start hyprpolkitagent 2>/dev/null

# Reload Hyprland so it picks up the new file
hyprctl reload

sleep 2

# cool notification
notify-send -a "Monitor Profile" -i display \
  "Workspace layout applied" \
  "Profile: <b>$profile</b>"

