#!/bin/bash

profile="$(kanshictl status | awk '{print $3}')"
principal="eDP-1"
secondary=""
tertiary=""

get_monitor_name_by_desc() {
    local wanted_desc="$1"
    hyprctl monitors all | awk -v desc="$wanted_desc" '
        /^Monitor / {
            mon=$2
            sub(/\(.*/, "", mon)
            gsub(/ $/, "", mon)
            current=mon
        }
        /^[[:space:]]*description: / {
            line=$0
            sub(/^[[:space:]]*description: /, "", line)
            if (line == desc) {
                print current
                exit
            }
        }
    '
}

case "$profile" in
    home_tri)
        principal="DP-5"
        secondary="DP-8"
        tertiary="HDMI-A-1"
        ;;
    office)
        principal="DP-6"
        secondary="DP-7"
        tertiary="eDP-1"
        ;;
    office2)
        principal="DP-5"
        secondary="DP-6"
        tertiary="eDP-1"
        ;;
    office3)
        principal="DP-5"
        secondary="DP-7"
        tertiary="eDP-1"
        ;;
    office5)
        principal="HDMI-A-1"
        secondary="eDP-1"
        ;;

    office30)
        principal="DP-7"
        secondary="DP-9"
        tertiary="eDP-1"
        ;;
    office26)
        principal="DP-7"
        secondary="DP-8"
        tertiary="eDP-1"
        ;;
    home)
        principal="DP-5"
        secondary="DP-8"
        tertiary="eDP-1"
        ;;
    home2)
        principal="DP-11"
        secondary="DP-7"
        tertiary="eDP-1"
        ;;
    office6)
        principal="DP-1"
        secondary="eDP-1"
        ;;
    home3)
        principal="DP-6"
        secondary="DP-10"
        tertiary="eDP-1"
        ;;
    # archZeta (home desktop). Uses monitor descriptions rather than connector
    # names: DP-N numbering shuffles between boots, descriptions do not.
    zeta)
        principal="AOC 27G2G4 0x00017409"
        secondary="Dell Inc. DELL P2417H 5N99G7CQ1D9B"
        tertiary=""
        ;;
esac

# The profiles above mix two styles: connector names (DP-5, eDP-1) and monitor
# descriptions. Resolve descriptions to whatever connector they landed on this
# boot; leave anything already shaped like a connector untouched.
resolve_monitor() {
    case "$1" in
        ""|eDP-[0-9]*|DP-[0-9]*|HDMI-A-[0-9]*) printf '%s' "$1" ;;
        *) get_monitor_name_by_desc "$1" ;;
    esac
}

principal="$(resolve_monitor "$principal")"
secondary="$(resolve_monitor "$secondary")"
tertiary="$(resolve_monitor "$tertiary")"

workspaces_file="$HOME/.config/hypr/workspaces.conf"

{
  echo "# Generated automatically for profile '$profile' on $(date '+%Y-%m-%d %H:%M:%S')"
  echo

  #
  # Workspaces 1–10 → principal monitor
  #
  echo "workspace=1,monitor:$principal,default:true"
  for i in {2..10}; do
    echo "workspace=$i,monitor:$principal"
  done

  #
  # Workspaces 11–19 → secondary monitor (only if present)
  #
  if [ -n "$secondary" ]; then
    echo "workspace=11,monitor:$secondary,default:true"
    for i in {12..19}; do
      echo "workspace=$i,monitor:$secondary"
    done
  fi

  #
  # Workspace 20 → tertiary monitor, if it exists;
  # otherwise → secondary monitor
  #
  if [ -n "$tertiary" ]; then
    echo "workspace=20,monitor:$tertiary"
  fi

} > "$workspaces_file"

# small delay
sleep 0.2

# 1–10 → principal
for i in {1..10}; do
    hyprctl dispatch moveworkspacetomonitor "$i" "$principal" >/dev/null 2>&1
done

# 11–19 → secondary
if [ -n "$secondary" ]; then
    for i in {11..19}; do
        hyprctl dispatch moveworkspacetomonitor "$i" "$secondary" >/dev/null 2>&1
    done
fi

# 20 → tertiary > secondary > principal
if [ -n "$tertiary" ]; then
    hyprctl dispatch moveworkspacetomonitor 20 "$tertiary" >/dev/null 2>&1
elif [ -n "$secondary" ]; then
    hyprctl dispatch moveworkspacetomonitor 20 "$secondary" >/dev/null 2>&1
else
    hyprctl dispatch moveworkspacetomonitor 20 "$principal" >/dev/null 2>&1
fi



# swww-daemon, waybar, wl-clip-persist, cliphist, hypridle and hyprpolkitagent are
# supervised by systemd (hyprland-session.target) and restart on their own, so this
# script no longer starts them. Never call `systemctl start` on the target from here:
# this runs inside kanshi.service, which is part of that target, and the job would
# wait on itself. Just re-apply the wallpaper across the new monitor layout.
for _ in $(seq 12); do
    awww img ~/Pictures/wallpapers/main.png 2>/dev/null && break
    sleep 0.25
done

# Reload Hyprland so it picks up the new file
hyprctl reload

sleep 2

# cool notification
notify-send -a "Monitor Profile" -i display \
  "Workspace layout applied" \
  "Profile: <b>$profile</b>"

